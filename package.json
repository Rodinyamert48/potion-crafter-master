{
  "name": "witchs-brew",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Witch's Brew – a pixel-art 2.5D potion shop simulator for the browser (Three.js + Babylon.js/Havok).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@babylonjs/core": "^9.28.0",
    "@babylonjs/havok": "^1.3.14",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
